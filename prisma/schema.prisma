datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Restaurant {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  domain           String?             @unique
  logoUrl          String?
  coverUrl         String?
  phone            String?
  email            String?
  address          String?
  currency         String              @default("PKR")
  currencySymbol   String              @default("Rs. ")
  taxRatePercent   Float               @default(5.0)
  primaryColor     String              @default("#ea580c")
  secondaryColor   String              @default("#0f172a")
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  branches         Branch[]
  users            User[]
  settings         RestaurantSetting?
  hours            BusinessHour[]
  deliveryZones    DeliveryZone[]
  categories       Category[]
  products         Product[]
  modifierGroups   ModifierGroup[]
  orders           Order[]
  coupons          Coupon[]
  reviews          Review[]
  customers        Customer[]
  payments         Payment[]
}

model Branch {
  id           String      @id @default(cuid())
  restaurantId String
  name         String
  slug         String
  address      String?
  phone        String?
  latitude     Float?
  longitude    Float?
  isMainBranch Boolean     @default(false)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([restaurantId, slug])
}

model RestaurantSetting {
  id                       String      @id @default(cuid())
  restaurantId             String      @unique
  minOrderAmount           Float       @default(500)
  estimatedPrepTimeMinutes Int         @default(30)
  deliveryRadiusKm         Float       @default(15.0)
  deliveryFeeBase          Float       @default(180)
  freeDeliveryThreshold    Float       @default(2000)
  acceptsCash              Boolean     @default(true)
  acceptsCard              Boolean     @default(true)
  autoAcceptOrders         Boolean     @default(false)
  soundNotificationEnabled Boolean     @default(true)
  noticeBanner             String?
  isStoreOpen              Boolean     @default(true)
  updatedAt                DateTime    @updatedAt

  restaurant               Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model BusinessHour {
  id           String      @id @default(cuid())
  restaurantId String
  dayOfWeek    Int         // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  openTime     String      // Format: "HH:mm"
  closeTime    String      // Format: "HH:mm"
  isClosed     Boolean     @default(false)

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
}

model DeliveryZone {
  id                      String      @id @default(cuid())
  restaurantId            String
  name                    String
  minDistanceKm           Float       @default(0)
  maxDistanceKm           Float       @default(5)
  deliveryFee             Float       @default(3.0)
  minOrderAmount          Float       @default(0)
  estimatedDeliveryMinutes Int        @default(35)

  restaurant              Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model User {
  id           String      @id @default(cuid())
  restaurantId String?     // Nullable for SUPER_ADMIN
  name         String
  email        String      @unique
  passwordHash String
  phone        String?
  role         String      @default("STAFF") // SUPER_ADMIN, RESTAURANT_ADMIN, STAFF, KITCHEN
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Category {
  id           String      @id @default(cuid())
  restaurantId String
  name         String
  slug         String
  description  String?
  imageUrl     String?
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([restaurantId, slug])
}

model Product {
  id                     String                 @id @default(cuid())
  restaurantId           String
  categoryId             String
  name                   String
  slug                   String
  description            String?
  basePrice              Float
  compareAtPrice         Float?
  imageUrl               String?
  isAvailable            Boolean                @default(true)
  isFeatured             Boolean                @default(false)
  preparationTimeMinutes Int                    @default(15)
  calories               Int?
  dietaryFlags           String                 @default("[]") // JSON string: ["veg", "halal", "spicy"]
  sortOrder              Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  restaurant             Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category               Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants               ProductVariant[]
  modifierGroupLinks     ProductModifierGroup[]
  orderItems             OrderItem[]
  reviews                Review[]

  @@unique([restaurantId, slug])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  name        String
  price       Float
  sku         String?
  isAvailable Boolean     @default(true)

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ModifierGroup {
  id             String                 @id @default(cuid())
  restaurantId   String
  name           String
  description    String?
  minSelections  Int                    @default(0)
  maxSelections  Int                    @default(1)
  isRequired     Boolean                @default(false)
  allowMultiple  Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers      Modifier[]
  productLinks   ProductModifierGroup[]
}

model ProductModifierGroup {
  id              String         @id @default(cuid())
  productId       String
  modifierGroupId String
  sortOrder       Int            @default(0)

  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
}

model Modifier {
  id              String         @id @default(cuid())
  modifierGroupId String
  name            String
  price           Float          @default(0.0)
  isDefault       Boolean        @default(false)
  isAvailable     Boolean        @default(true)

  modifierGroup   ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
}

model Customer {
  id           String      @id @default(cuid())
  restaurantId String
  name         String
  email        String
  phone        String
  passwordHash String?
  isGuest      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  addresses    Address[]
  orders       Order[]

  @@unique([restaurantId, email])
}

model Address {
  id                   String      @id @default(cuid())
  customerId           String
  label                String      @default("Home")
  street               String
  city                 String
  postalCode           String?
  deliveryInstructions String?
  isDefault            Boolean     @default(false)

  customer             Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Coupon {
  id                   String        @id @default(cuid())
  restaurantId         String
  code                 String
  discountType         String        @default("PERCENTAGE") // "PERCENTAGE" or "FIXED_AMOUNT"
  discountValue        Float
  minOrderAmount       Float         @default(0)
  maxDiscountAmount    Float?
  startDate            DateTime?
  endDate              DateTime?
  usageLimitTotal      Int?
  usageLimitPerCustomer Int          @default(1)
  timesUsed            Int           @default(0)
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  restaurant           Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  usages               CouponUsage[]

  @@unique([restaurantId, code])
}

model CouponUsage {
  id              String      @id @default(cuid())
  couponId        String
  orderId         String
  customerId      String?
  discountApplied Float
  usedAt          DateTime    @default(now())

  coupon          Coupon      @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Order {
  id                  String         @id @default(cuid())
  restaurantId        String
  branchId            String?
  customerId          String?
  orderNumber         String         @unique // e.g. "UB-1001"
  status              String         @default("PENDING") // PENDING, CONFIRMED, PREPARING, READY, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, REJECTED
  orderType           String         @default("DELIVERY") // DELIVERY, PICKUP, DINE_IN
  customerName        String
  customerEmail       String
  customerPhone       String
  deliveryAddress     String?        // JSON string with street, city, notes
  subtotal            Float
  discountAmount      Float          @default(0)
  deliveryFee         Float          @default(0)
  taxAmount           Float          @default(0)
  tipAmount           Float          @default(0)
  totalAmount         Float
  paymentMethod       String         @default("CASH_ON_DELIVERY") // CASH_ON_DELIVERY, PAY_AT_RESTAURANT, STRIPE
  paymentStatus       String         @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  specialInstructions String?
  cancelReason        String?
  confirmedAt         DateTime?
  preparingAt         DateTime?
  readyAt             DateTime?
  outForDeliveryAt    DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  restaurant          Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch              Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer            Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  couponUsages        CouponUsage[]
  payments            Payment[]
}

model OrderItem {
  id                  String              @id @default(cuid())
  orderId             String
  productId           String?
  productName         String
  productPrice        Float
  quantity            Int
  itemTotal           Float
  specialInstructions String?

  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  modifiers           OrderItemModifier[]
}

model OrderItemModifier {
  id            String    @id @default(cuid())
  orderItemId   String
  modifierId    String?
  modifierName  String
  modifierPrice Float     @default(0.0)
  quantity      Int       @default(1)

  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String      @id @default(cuid())
  orderId       String
  restaurantId  String
  provider      String      // CASH_ON_DELIVERY, PAY_AT_RESTAURANT, STRIPE, etc.
  transactionId String?
  amount        Float
  status        String      @default("PENDING") // PENDING, COMPLETED, FAILED
  metadata      String?     // JSON metadata
  createdAt     DateTime    @default(now())

  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id           String      @id @default(cuid())
  restaurantId String
  productId    String?
  customerName String
  rating       Int         @default(5)
  comment      String?
  isApproved   Boolean     @default(true)
  createdAt    DateTime    @default(now())

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
}
